{
  "manifest_version": 3,
  "name": "Cachenect",
  "version": "1.0",

  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },

  "description": "Firefox extension to cache connect (connect.det.wa.edu.au) data and present it in an alternative view",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse",
    "storage"
  ],
  "host_permissions": ["*://connect.det.wa.edu.au/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "cachenect@humanoidkiwifruit.github.io",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["background/index.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Open Viewer"
  }
}
